{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "非遗制式与衍生谱系库领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "STANDARD_RECORDED",
        "STANDARD_SIGNED",
        "ELEMENT_REGISTERED",
        "PROCESS_VERSION_RECORDED",
        "MOLD_RECORDED",
        "GRANT_ISSUED",
        "GRANT_WITHDRAWN",
        "DESIGN_FROZEN",
        "DESIGN_APPROVED",
        "BATCH_CREATED",
        "BATCH_SPLIT",
        "BATCH_MERGED",
        "BATCH_REWORKED",
        "ITEM_REGISTERED",
        "ITEM_REVIEW_LOCKED",
        "ITEM_SOLD",
        "STATEMENT_APPROVED",
        "COURSE_CITED",
        "COURSE_ENDED",
        "DISPOSITION_OPENED",
        "DISPOSITION_RESOLVED",
        "RUN_STARTED",
        "RUN_ADVANCED",
        "RUN_FINISHED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "craft_standard",
        "classic_element",
        "process_version",
        "mold_source",
        "lineage_grant",
        "design",
        "work_batch",
        "work_item",
        "course",
        "public_statement",
        "disposition",
        "discovery_run"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "aggregate_for_event": {
    "STANDARD_RECORDED": "craft_standard",
    "STANDARD_SIGNED": "craft_standard",
    "ELEMENT_REGISTERED": "classic_element",
    "PROCESS_VERSION_RECORDED": "process_version",
    "MOLD_RECORDED": "mold_source",
    "GRANT_ISSUED": "lineage_grant",
    "GRANT_WITHDRAWN": "lineage_grant",
    "DESIGN_FROZEN": "design",
    "DESIGN_APPROVED": "design",
    "BATCH_CREATED": "work_batch",
    "BATCH_SPLIT": "work_batch",
    "BATCH_MERGED": "work_batch",
    "BATCH_REWORKED": "work_batch",
    "ITEM_REGISTERED": "work_item",
    "ITEM_REVIEW_LOCKED": "work_item",
    "ITEM_SOLD": "work_item",
    "STATEMENT_APPROVED": "public_statement",
    "COURSE_CITED": "course",
    "COURSE_ENDED": "course",
    "DISPOSITION_OPENED": "disposition",
    "DISPOSITION_RESOLVED": "disposition",
    "RUN_STARTED": "discovery_run",
    "RUN_ADVANCED": "discovery_run",
    "RUN_FINISHED": "discovery_run"
  },
  "payload_required_by_event": {
    "STANDARD_RECORDED": [
      "name",
      "tradition",
      "version",
      "element_ids",
      "process_version_ids"
    ],
    "STANDARD_SIGNED": [
      "standard_version",
      "reviewer_id",
      "reviewer_kind"
    ],
    "ELEMENT_REGISTERED": [
      "name",
      "canonical_spec"
    ],
    "PROCESS_VERSION_RECORDED": [
      "standard_id",
      "version",
      "steps"
    ],
    "MOLD_RECORDED": [
      "origin",
      "acquired_at"
    ],
    "GRANT_ISSUED": [
      "grantor_id",
      "grantee_id",
      "scope",
      "valid_from",
      "valid_until"
    ],
    "GRANT_WITHDRAWN": [
      "effective_at",
      "reason",
      "replaces_scope"
    ],
    "DESIGN_FROZEN": [
      "designer_id",
      "element_refs",
      "process_refs",
      "mold_refs",
      "grant_snapshot",
      "content_fingerprint"
    ],
    "DESIGN_APPROVED": [
      "approvals"
    ],
    "BATCH_CREATED": [
      "quantity",
      "basis"
    ],
    "BATCH_SPLIT": [
      "source_batch_id",
      "splits"
    ],
    "BATCH_MERGED": [
      "source_batch_ids",
      "quantity"
    ],
    "BATCH_REWORKED": [
      "source_batch_id",
      "quantity",
      "reason"
    ],
    "ITEM_REGISTERED": [
      "batch_id",
      "item_no",
      "content_fingerprint",
      "contributor_ids",
      "basis"
    ],
    "ITEM_REVIEW_LOCKED": [
      "reason"
    ],
    "ITEM_SOLD": [
      "sold_at"
    ],
    "STATEMENT_APPROVED": [
      "subject_ref",
      "audience",
      "context",
      "basis",
      "title",
      "claim"
    ],
    "COURSE_CITED": [
      "course_name",
      "provider_id",
      "citations"
    ],
    "COURSE_ENDED": [
      "ended_at"
    ],
    "DISPOSITION_OPENED": [
      "trigger",
      "grant_id",
      "scope_after",
      "affected"
    ],
    "DISPOSITION_RESOLVED": [
      "resolution",
      "resolved_at"
    ],
    "RUN_STARTED": [
      "plan"
    ],
    "RUN_ADVANCED": [
      "step",
      "disposition_ids"
    ],
    "RUN_FINISHED": [
      "summary"
    ]
  },
  "additionalProperties": false
}
